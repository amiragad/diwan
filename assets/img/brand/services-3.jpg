<style>
    .box {
box-shadow: 0px 0px 2px 0px rgba(0,0,0,0.2);
       
    }
</style>

 <nav class="z-3 menu_cololr box bg-white position-fixed p-10  w-100 l-0">

      <div class="mx-auto mw-320 mw-md-1140 d-flex  flex-direction-column align-items-flex-start justify-content-space-between flex-direction-md-row align-items-md-center">
    
      
    <img class="mw-150 mw-md-200 " src="logo.png" onclick="location.href='/'">
        
        
        
 <label class="menu__btn" for="menu__toggle">
      <span></span>
      
    </label>
<input id="menu__toggle" type="checkbox">

<style>

#menu__toggle {
    -webkit-appearance: none;    -moz-appearance: none;    appearance: none;
}
#menu__toggle:checked ~ .menu__btn > span {
  transform: rotate(45deg);
  
}
#menu__toggle:checked ~ .menu__btn > span::before {
  top: 0;
  transform: rotate(0);
}
#menu__toggle:checked ~ .menu__btn > span::after {
  top: 0;
  transform: rotate(90deg);
}
#menu__toggle:checked ~ .menu .mobile {
    margin-top: 0%;
}

#menu__toggle:checked ~ .menu__btn > span, .menu__btn > span::before, .menu__btn > span::after {
    display: block;
    position: absolute;
    width: 90%;
    height: 2px;
    background-color: #223f87;
    transition-duration: .25s;
}

.menu ul li button {
    display:none;
}    
@media only screen and (max-width: 768px) {
    .menu_cololr {
   background-color: white;
    }
    .menu ul li button {
    display:block;
}   

.menu__btn {
    display: flex;
    align-items: center;
    position: absolute;
    padding: 5px;
    right: 75px;
    top: 14px;
    width: 33px;
    height: 33px;
    cursor: pointer;
    color:#223f87 !important;

}

label.menu__btn:after {
    content: "Menu";
    position: absolute;
    left: 40px;
    font-size:16px;
}

label {
    display: inline-block;
}
.menu__btn > span, .menu__btn > span::before, .menu__btn > span::after {
    display: block;
    position: absolute;
    width: 75%;
    height: 2px;
    background-color: #223f87;
    transition-duration: .25s;
}

.menu__btn > span::before {
    content: '';
    top: -8px;
}
.menu__btn > span::after {
    content: '';
    top: 8px;
}


}
nav.menu {
    position: relative;
    width:100%;
    max-width: 700px;
}

.menu ul {
  list-style: none;
  padding: 0;
  margin: 0;

}

.menu ul li {
  display: block;
  position: relative;
  float: right;
}

/* This hides the dropdowns */


.menu li ul { display: none; }

.menu ul li a {
  display: block;
  text-decoration: none;
  white-space: nowrap;
  color: #606060;
  line-height: 2.5;
    font-weight: normal;
}

.menu ul ul li a {
    padding:0.5em;
}

/* Display the dropdown */





.menu li:hover li { float: none; }

.menu ul li:hover  li a:hover {
  
    color: white;
      background: #606060;
     
 }

.menu li ul li { border-top: 0; }

/* Displays second level dropdowns to the right of the first level dropdown */


.menu ul ul ul {
  left: 100%;
  top: 0;
}




.menu ul:after { clear: both; }

ul.mobile {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    max-width: 700px;
}

@media only screen and (min-width: 768px) {
    
    .menu li:hover > ul li a {
    color: #606060;
}
    .menu li:hover > ul {
  display: block;
  position: absolute;
  background:white;
  color:white;
}
}

@media only screen and (max-width: 768px) {
    

.menu .mobile {
    padding-top: 45px;
}
.menu li:hover > ul {
  position: relative;
width:100%;   
    height: 100%;
}



.menu .mobile {
    height: 100vh;
    overflow: overlay;
    position: relative;
    display: flex;
    left: 0px;
    width: 100%;
    transition-duration: .25s;
    flex-direction: column;
    justify-content: flex-start;
    gap: 15px;
    padding-bottom: 50px;
    margin-top: -3000%;
}

.menu ul li a {
    width: 80%;
    text-wrap: auto;
    
}

.menu ul li  {
    width: 100%;
}


.menu li button:hover > ul {
    display: block;
    position: absolute;
    width:100%;
}

.menu li button {
 height: 30px;
    width: 30px;
    background: #223f87;
    border-radius: 3px;
    color: white;
    font-size: 25px;
    position: absolute;
    right: 15px;
    top: 0px;
    margin:0px;
    padding:0px;
}

.menu ul ul ul {
    left: auto;
    top: 0;
    width:100%;
}
}

